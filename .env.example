# Copy to .env and edit. Every value is optional; defaults shown.
# .env holds secrets: never commit or share it.

# --- Dashboard --------------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8000

# --- Alerts -------------------------------------------------------------
# Discord channel → Edit Channel → Integrations → Webhooks → Copy URL
DISCORD_WEBHOOK_URL=
TERMINAL_BELL=1
ALERT_COOLDOWN_SECONDS=600

# --- Scanning & sizing (CLI flags override these) ---------------------------
# Three separate cadences, in seconds. Each loop runs on its own and never overlaps itself.
# Price/orderbook re-pricing of already-matched pairs. Minimum 3. Uses batched requests (100 markets
# per call) and backs off automatically on HTTP 429. 3 s is best for a focused set of active pairs.
PRICE_POLL_INTERVAL_SEC=3
# Full Kalshi + Polymarket market-list download (takes a few minutes live). Minimum 60.
CATALOG_POLL_INTERVAL_SEC=300
# Claude CLI matching of new/changed markets (uses Claude Pro usage). Minimum 300.
MATCH_INTERVAL_SEC=900
# Hard cap on exposure per platform, USD. Each leg is sized to the smaller of
# (this cap − open positions on that platform) and your live cash balance there.
MAX_PER_PLATFORM_USD=50.0
# Minimum guaranteed net ROI after ALL fees on both platforms (profit / total cost, %)
# Qualify by ANNUALIZED ROI = net ROI × 365 / days until the later settlement date (simple, not
# compounded). 6.0 beats a ~4.5-5% money-market yield; use 8.0 or more to be pickier.
MIN_ANNUALIZED_ROI=6.0
# ...and a small raw net-ROI floor (%) so 1-day contracts with $0.02 spreads don't qualify on paper.
# Each opportunity must clear net ROI >= max(MIN_NET_ROI_PCT, MIN_ANNUALIZED_ROI × days / 365).
MIN_NET_ROI_PCT=0.35
MIN_TOP_LIQUIDITY_USD=50
# Risk-free money-market yield (annual %) used for the dashboard's "MMF hurdle" win rate:
# cost per $1 × (1 + rate × lock-up days / 365). Display only; it does not change any gate.
MMF_BENCHMARK_RATE=4.5

# --- Bulletproof arbitrage (ALL must pass for a LIVE ARBITRAGE alert / auto-trade) ---------
# Everything else is shown on the Watchlist with the exact reasons it failed.
# Max difference between Kalshi's expected settlement and Polymarket's end date, in days
MAX_SETTLE_DIFF_DAYS=1
# Strict rule check: Claude compares BOTH full rulebooks (proposition, outcome alignment, resolution
# source, deadline/cutoff, edge cases) and must call them identical with at least this confidence (0-100)
STRICT_MATCH_CONFIDENCE=98
# Exclude contracts that lock capital longer than this (days until the later settlement date)
MAX_LOCKUP_DAYS=90
# The whole per-platform budget must fill at the ROI floor when the books are walked (VWAP)
REQUIRE_FULL_DEPTH=1
# Model for the strict rule check (runs only on profitable pairs that pass every other check)
STRICT_VERIFY_MODEL=sonnet
STRICT_VERIFY_MAX_PER_HOUR=30
# Re-check a verified pair after this long (any change to either rulebook re-checks immediately)
STRICT_VERIFY_TTL_HOURS=72
WATCHLIST_COUNT=25

# --- Execution ----------------------------------------------------------------
# alert_only  find + size arbs and alert you; never touches an order endpoint (default)
# dry_run     full execution path with fresh books, balances and signed payloads, but sends nothing
# live_auto   places REAL orders on both platforms when every safety check passes
#             (starts disarmed: press "Enable auto-trade" on the dashboard)
EXECUTION_MODE=alert_only
# live_auto / dry_run only trade pairs you approved on the dashboard (strongly recommended)
REQUIRE_PAIR_APPROVAL=1
# ...and only pairs Claude matched with at least this confidence
EXECUTION_MIN_CONFIDENCE=0.95
# Don't re-trade the same pair/direction within this many seconds
EXECUTION_COOLDOWN_SECONDS=600
# If leg 2 fails, sell the Kalshi leg back no lower than (its fill price − this, in $ per contract)
FLATTEN_MAX_SLIPPAGE=0.10
BALANCE_REFRESH_SECONDS=30
TRADES_FILE=trades.json
EXECUTION_STATE_FILE=execution_state.json

# --- Kalshi API key (needed for balances and orders; scanning works without) --
# Create a key in your Kalshi account settings (API keys); guide: docs.kalshi.com/getting_started/api_keys. Save the downloaded private key
# file somewhere private (NOT inside this folder if you ever share it) and point to it here.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# ...or paste the PEM inline instead of a path (use 
 for line breaks):
KALSHI_PRIVATE_KEY=
# To test against Kalshi's demo exchange with demo keys, use:
#   KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2

# --- Polymarket (needed for balances and orders; scanning works without) -------
# Requires Python 3.11+ and `pip install polymarket-client` (see README → Polymarket setup).
# Polymarket blocks new orders from some regions, including the US; the app checks
# https://polymarket.com/api/geoblock and disables Polymarket execution when blocked.
# The EVM private key that signs for your Polymarket account (export it from your wallet / Polymarket settings)
POLY_PRIVATE_KEY=
# Your EXISTING Polymarket wallet address that holds your pUSD (required)
POLY_WALLET_ADDRESS=

# --- Mock mode only (python main.py --mock) ----------------------------------
MOCK_KALSHI_BALANCE=45
MOCK_POLY_BALANCE=60
# none | leg2_reject (Polymarket leg fails → Kalshi leg flattened) | unhedged (flatten fails too)
MOCK_EXEC_FAIL=none

# --- Fees -----------------------------------------------------------------
KALSHI_TAKER_FEE_RATE=0.07
# "auto" reads each Polymarket market's live feeSchedule; a number (e.g. 0.04) forces one rate everywhere
POLY_TAKER_FEE_RATE=auto

# --- Claude CLI matcher (uses your logged-in Claude Pro session, no API key) --
# Leave empty to auto-discover: native installer (%USERPROFILE%\.local\bin\claude.exe),
# %LOCALAPPDATA%\Programs\claude\claude.exe, PATH, then %APPDATA%\npm\claude.cmd. Installs that
# don't actually run (e.g. a broken npm shim) are skipped. Set a full path here to force one.
CLAUDE_CLI_PATH=
CLAUDE_MODEL=haiku
# Extra flags appended to `claude -p --model haiku --output-format json`
CLAUDE_EXTRA_ARGS=
CLAUDE_TIMEOUT_SECONDS=180
CLAUDE_RETRIES=2
# Usage budget per refresh = MATCH_BATCH_SIZE × MATCH_MAX_BATCHES_PER_REFRESH Kalshi markets
MATCH_BATCH_SIZE=25
MATCH_MAX_BATCHES_PER_REFRESH=20
MATCH_CANDIDATES_PER_MARKET=3
MATCH_MIN_SIMILARITY=0.35
MATCH_MAX_DATE_GAP_DAYS=31
# Long-dated markets may also differ by up to this fraction of the time left (0.25 = 3 months on a 1-year market)
MATCH_DATE_GAP_FRACTION=0.25
# Share each Claude round across categories (and series) so sports props can't take the whole budget
MATCH_STRATIFY=1
MATCH_MIN_CONFIDENCE=0.85
MATCH_CACHE_TTL_HOURS=168
MATCH_CACHE_FILE=matches_cache.json

# --- HTTP / endpoints -------------------------------------------------------
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
POLY_GAMMA_URL=https://gamma-api.polymarket.com
POLY_CLOB_URL=https://clob.polymarket.com
# Kalshi Basic tier allows ~20 reads/s; catalog paging and price polling use separate limiters
KALSHI_REQUESTS_PER_SECOND=10
KALSHI_PRICE_REQUESTS_PER_SECOND=4
HTTP_TIMEOUT=20
HTTP_RETRIES=4
# Safety cap only: the full open Kalshi catalog is ~205 pages of 1,000 markets
KALSHI_MAX_PAGES=1000
POLY_MAX_PAGES=3000
LOG_FILE=scanner.log
